#!/usr/bin/env python3
"""Explicit updater-signing provision/refresh and offline metadata checks.

No runtime authorization. Never replaces unmanaged files or existing canonical
items. The private seed is consumed only through protected files/stdin.
"""
import base64, hashlib, json, os, pathlib, stat, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
SCHEMA = json.loads((ROOT / '.dev-secrets/updater-signing.json').read_text())
CONFIG = json.loads((ROOT / SCHEMA['publicConfig']).read_text())
TARGET = ROOT / SCHEMA['managedPath']
STATE = TARGET.parent / 'state.json'

def fail(message):
    raise RuntimeError(message)

def private_file(path):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
        fail('Signing file must be a regular, owner-owned file with mode 0600')
    if path.parent.is_symlink(): fail('Signing directory must not be a symlink')
    parent = path.parent.stat()
    if parent.st_uid != os.getuid() or stat.S_IMODE(parent.st_mode) != 0o700:
        fail('Signing directory must be owner-owned with mode 0700')

def normalize(raw):
    try:
        text = raw.decode('ascii').strip()
        decoded = base64.b64decode(text, validate=True)
    except (ValueError, UnicodeError):
        fail('Signing seed has an invalid format')
    if len(decoded) != 32:
        fail('Signing seed must decode to 32 bytes')
    return (text + '\n').encode('ascii')

def check_public(raw):
    # CryptoKit ships with macOS. The private seed goes through stdin only.
    swift = '''import Foundation
import CryptoKit
let input = FileHandle.standardInput.readDataToEndOfFile()
guard let text = String(data: input, encoding: .utf8), let seed = Data(base64Encoded: text.trimmingCharacters(in: .whitespacesAndNewlines)) else { exit(1) }
do { print(try Curve25519.Signing.PrivateKey(rawRepresentation: seed).publicKey.rawRepresentation.base64EncodedString()) } catch { exit(1) }
'''
    with tempfile.TemporaryDirectory(prefix='transcribe-key-validation-') as directory:
        source = pathlib.Path(directory) / 'PublicKey.swift'
        source.write_text(swift)
        result = subprocess.run(['swift', str(source)], input=raw, capture_output=True)
    if result.returncode or result.stdout.decode().strip() != CONFIG['publicKey']:
        fail('Signing seed does not match the pinned public key')

def canonical_read():
    result = subprocess.run(['op', 'read', SCHEMA['reference']], capture_output=True)
    if result.returncode:
        fail('Canonical updater signing item is unavailable; existing files preserved')
    raw = normalize(result.stdout)
    check_public(raw)
    return raw

def managed_status():
    ignored = subprocess.run(['git','check-ignore','-q',str(TARGET)], cwd=ROOT).returncode == 0
    untracked = not subprocess.run(['git','ls-files','--error-unmatch',str(TARGET)], cwd=ROOT, capture_output=True).returncode == 0
    if not ignored or not untracked:
        fail('Signing file must be ignored and untracked')
    if not os.path.lexists(TARGET):
        print('Updater signing: not provisioned locally; canonical reference configured')
        return False
    private_file(TARGET)
    if not STATE.exists():
        fail('Unmanaged signing file preserved; adoption requires explicit review')
    private_file(STATE)
    metadata = json.loads(STATE.read_text())
    if metadata.get('reference') != SCHEMA['reference'] or metadata.get('sha256') != hashlib.sha256(TARGET.read_bytes()).hexdigest():
        fail('Managed signing file changed; working file preserved')
    print('Updater signing: managed, ignored, untracked, owner-only; offline status OK')
    return True

def refresh():
    managed_status()
    raw = canonical_read()
    if TARGET.parent.is_symlink(): fail('Managed secret directory must not be a symlink')
    TARGET.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if TARGET.parent.stat().st_uid != os.getuid() or stat.S_IMODE(TARGET.parent.stat().st_mode) != 0o700:
        fail('Managed secret directory permissions are unsafe; no files changed')
    # Validate all input first, then replace only known managed files atomically.
    for path, content in [(TARGET, raw), (STATE, (json.dumps({'reference': SCHEMA['reference'], 'sha256': hashlib.sha256(raw).hexdigest()}, indent=2)+'\n').encode())]:
        descriptor, name = tempfile.mkstemp(dir=TARGET.parent)
        try:
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, 'wb') as file: file.write(content)
            os.replace(name, path)
        finally:
            if os.path.exists(name): os.unlink(name)
    managed_status()

def canonicalize(path):
    # One-time, explicitly requested creation of this NEW scoped item only.
    private_file(path)
    raw = normalize(path.read_bytes())
    check_public(raw)
    result = subprocess.run(['op','item','list','--vault','Sebastian Work','--format','json'], capture_output=True)
    if result.returncode: fail('Cannot check canonical item metadata; no item created')
    if any(item.get('title') == 'Transcribe — Update signing' for item in json.loads(result.stdout)):
        fail('Canonical updater item already exists; preserved without modification')
    payload = {'title':'Transcribe — Update signing','category':'API_CREDENTIAL','fields':[
        {'id':'credential','label':'credential','type':'CONCEALED','value':raw.decode().strip()},
        {'id':'notesPlain','label':'notesPlain','type':'STRING','value':'Scope: Transcribe macOS updater only\nKeychain account: '+CONFIG['keychainAccount']+'\nPublic key: '+CONFIG['publicKey']}]}
    result = subprocess.run(['op','item','create','-','--vault','Sebastian Work','--format','json'], input=json.dumps(payload).encode(), capture_output=True)
    if result.returncode: fail('Canonical creation denied or failed; protected export preserved')
    if canonical_read() != raw: fail('Canonical recovery mismatch; protected export preserved')
    print('New canonical updater signing item created and privately recovered; public key matches')
    refresh()

try:
    command = sys.argv[1] if len(sys.argv) > 1 else 'status'
    if command == 'status' and len(sys.argv) <= 2: managed_status()
    elif command in ('provision','refresh') and len(sys.argv) == 2: refresh()
    elif command == 'canonicalize-new-updater' and len(sys.argv) == 3: canonicalize(pathlib.Path(sys.argv[2]).absolute())
    else: fail('Usage: scripts/dev-secrets status|provision|refresh|canonicalize-new-updater protected-export-path')
except (RuntimeError, OSError, ValueError) as error:
    print('Development secrets: '+str(error), file=sys.stderr)
    sys.exit(1)
